{
  "name": "lookup",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run --config worker/vitest.config.ts && pnpm --filter @heresmychurch/lookup test",
    "typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "deploy": "pnpm run build:sdk && pnpm run build:docs && wrangler deploy --config worker/wrangler.jsonc",
    "build:docs": "node scripts/build-docs.mjs",
    "eval": "node eval/run.mjs",
    "build:sdk": "pnpm --filter @heresmychurch/lookup build && node scripts/copy-assets.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "marked": "15.0.12",
    "shiki": "3.4.2",
    "typescript": "^5.6.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.150.0"
  }
}
