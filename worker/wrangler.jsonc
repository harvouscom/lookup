{
  "name": "hmc-lookup",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Invocation logs stay off so queries aren't stored.
  "observability": { "enabled": false },
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "hmc-lookup", "database_id": "8728a664-c1df-4003-89a7-679693ac9adb" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ratelimits": [{ "name": "RL_SEARCH", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } }]
}
