{
  "name": "hmc-lookup",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Invocation logs stay off so queries aren't stored.
  "observability": { "enabled": false },
  "workers_dev": true,
  // /element.js, /lookup.js and /examples come from here; everything else runs the Worker.
  // /video/* runs the Worker first: the homepage video streams from R2 (MEDIA) with byte ranges.
  "assets": { "directory": "../site", "binding": "ASSETS", "run_worker_first": ["/video/*"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lookup-media" }],
  "routes": [{ "pattern": "lookup.heresmychurch.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "hmc-lookup", "database_id": "8728a664-c1df-4003-89a7-679693ac9adb" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VEC", "index_name": "hmc-lookup-bge-m3" }],
  "services": [{ "binding": "HMC_API", "service": "hmc-api" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "limits": { "cpu_ms": 120000 },
  // Kill switches: set either to "false" and redeploy to turn the feature off.
  "vars": { "SEMANTIC_ENABLED": "true", "SYNC_ENABLED": "true", "CONTRIBUTIONS_ENABLED": "true", "NAME_CONTRIBUTIONS": "true", "CONTRIBUTIONS_DAILY_CAP": "2000", "ADD_ENABLED": "true", "ASK_ENABLED": "true" },
  "ratelimits": [
    { "name": "RL_SEARCH", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SEMANTIC", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_CONTRIB", "namespace_id": "4103", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_ASK", "namespace_id": "4104", "simple": { "limit": 10, "period": 60 } }
  ]
}
